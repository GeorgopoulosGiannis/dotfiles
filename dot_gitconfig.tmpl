# git-lfs filter (installed by the package scripts). `required` makes git fail loudly
# instead of committing raw pointer files when git-lfs is missing.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = GeorgopoulosGiannis
{{- with get . "email" }}
	email = {{ . }}
{{- end }}
[core]
	editor = {{ if eq (get . "profile" | default "dev") "dev" }}nvim{{ else }}vim{{ end }}
	quotepath = false
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	rebase = true
[fetch]
	prune = true
[checkout]
	defaultRemote = origin
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[help]
	autocorrect = prompt
[rebase]
	updateRefs = true
	autoSquash = true
	autoStash = true
[merge]
	conflictstyle = zdiff3
[commit]
	verbose = true
[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
	mnemonicPrefix = true
[rerere]
	enabled = true
{{- if (get . "work" | default false) }}
# Work-only rules (e.g. work email per org) live in the private dotfiles-work repo.
[include]
	path = ~/.local/share/dotfiles-work/gitconfig
{{- end }}
