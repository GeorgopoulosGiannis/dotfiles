# Ensure vi keys are enabled in copy mode
setw -g mode-keys vi

set -g mouse on

# Short ESC delay (10ms) so vi-mode in the shell and Neovim feels instant; pass focus events to apps
set -sg escape-time 10
set -g focus-events on

set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-ghostty:RGB"
set -as terminal-features ",xterm-ghostty:extkeys"
set -g extended-keys on
# Encode modified keys (Shift+Enter, Ctrl+Space, ...) as CSI u; pi parses this reliably.
# The option exists since tmux 3.5, so only set it when this tmux is new enough.
if-shell 'v=$(tmux -V | cut -d" " -f2); [ "$(printf "%s\n3.5\n" "$v" | sort -V | head -n1)" = 3.5 ]' \
  'set -g extended-keys-format csi-u'

# Configure 'v' to begin selection and 'y' to copy (yank) and exit
bind-key -T copy-mode-vi v send-keys -X begin-selection
{{- if eq .chezmoi.os "darwin" }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
{{- else }}
# No system clipboard on a server: copy via OSC52 so yanks reach the local terminal
set -g set-clipboard on
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
{{- end }}
# Switch panes with prefix + h/j/k/l; resize with prefix + H/J/K/L (repeatable)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Session/window pickers sorted by name (zoomed)
bind w choose-tree -wZ -O name
bind s choose-tree -sZ -O name

{{- if ne (get . "profile" | default "dev") "server" }}
# pi: jump to next pane that needs you (bash-guard waiting first, then finished agents)
bind N run-shell -b "~/.pi/agent/extensions/notify-done/queue.sh jump '' '#{client_name}'"
# pi: show the pending queue in order (pick one to jump)
bind Q run-shell -b "~/.pi/agent/extensions/notify-done/queue.sh menu '#{client_name}'"
{{- end }}

# Reboot recovery: restore the workspace, never rerun commands or capture pane text.
# Snapshots stay local (not in chezmoi/Git). Prefix + Ctrl-s saves; Ctrl-r restores.
set -g @resurrect-dir '~/.local/share/tmux/resurrect'
set -g @resurrect-processes 'false'
set -g @resurrect-capture-pane-contents 'off'
set -g @continuum-save-interval '5'
set -g @continuum-restore 'on'
set -g @continuum-boot 'off'
run-shell 'mkdir -p "$HOME/.local/share/tmux/resurrect" && chmod 700 "$HOME/.local/share/tmux/resurrect"'
run-shell '~/.tmux/plugins/tmux-resurrect/resurrect.tmux'
# Keep continuum last: autosave depends on its status-right hook (status must be on).
run-shell '~/.tmux/plugins/tmux-continuum/continuum.tmux'

